        <mxCell id="23ysbeV23IqRzbt1sjMq-318" connectable="0" parent="e100" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;Phase 2 đọc output của Phase 1&lt;/b&gt;&lt;/font&gt;" vertex="1">
