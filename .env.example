# MongoDB Development Environment
MONGO_DEV_HOST=localhost
MONGO_DEV_PORT=27017
MONGO_DEV_USER=your_username
MONGO_DEV_PASSWORD=your_password
MONGO_DEV_DATABASE=your_database

# MongoDB Production Environment
MONGO_PROD_HOST=prod_host
MONGO_PROD_PORT=27017
MONGO_PROD_USER=prod_username
MONGO_PROD_PASSWORD=prod_password
MONGO_PROD_DATABASE=prod_database

# Neo4j Development Environment
NEO4J_DEV_HOST=localhost
NEO4J_DEV_PORT=7687
NEO4J_DEV_USER=neo4j
NEO4J_DEV_PASSWORD=password
NEO4J_DEV_DATABASE=neo4j

# Neo4j Production Environment
NEO4J_PROD_HOST=prod_host
NEO4J_PROD_PORT=7687
NEO4J_PROD_USER=neo4j
NEO4J_PROD_PASSWORD=prod_password
NEO4J_PROD_DATABASE=neo4j

# Elasticsearch Development Environment
ES_DEV_USER=es_username
ES_DEV_PASSWORD=es_password
ES_DEV_ENDPOINT=es_endpoint
ES_DEV_DOCUMENT_INDEX=es_db
ES_DEV_TERM_INDEX=es_db2

# Database
MONGO_PROD_DATABASE=vanbanphapluat
CLS_DATABASE=vanbanphapluat
CLS_COLLECTION=cls_ver2
MONGO_DEV_DATABASE=ie
IE_DATABASE=ie
IE_COLLECTION=ie_collection

# LLM fallback for relation extraction
# These override the built-in defaults used by LangExtractRelationFallback.
LEGAL_LLM_MODEL_ID=
LEGAL_LLM_BASE_URL=
LEGAL_LLM_API_KEY=
